{
  "name": "hotdogcart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file=.env --watch src/server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node --env-file=.env src/server/index.js",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:test-user": "node --env-file=.env scripts/seed-test-user.js",
    "user:create": "node --env-file-if-exists=.env scripts/create-user.js",
    "user:password": "node --env-file-if-exists=.env scripts/create-user.js --password"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.5.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.28.0",
    "vite": "^6.3.0"
  }
}
